; Recursion + conditionals: classic Fibonacci.
(def fib (fn (n)
  (if (< n 2) n
    (+ (fib (- n 1)) (fib (- n 2))))))

(print "fib 10 =" (fib 10))   ; 55
(print "fib 20 =" (fib 20))   ; 6765

; Iterative version: a while loop mutating bindings in the let scope.
; (def rebinds in the current scope, so the loop body updates a/b/i in place.)
(def fib-iter (fn (n)
  (let ((a 0) (b 1) (i 0))
    (while (< i n)
      (def t (+ a b))
      (def a b)
      (def b t)
      (def i (+ i 1)))
    a)))

(print "fib-iter 20 =" (fib-iter 20))   ; 6765
