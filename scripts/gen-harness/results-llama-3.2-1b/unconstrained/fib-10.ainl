```python
def fib(n):
    if n == 0:
        return 0
    elif n == 1:
        return 1
    else:
        fib_prev = 0
        fib_curr = 1
        for _ in range(2, n):
            fib_next = fib_prev + fib_curr
            fib_prev = fib_curr
            fib_curr = fib_next
        return fib_curr

def main():
    print(fib(10))

if __name__ == "__main__":
    main()
```

