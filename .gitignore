# Rust
/target
**/*.rs.bk
Cargo.lock

# Release packaging output
/dist

# AOT codegen scratch (ainl compile writes this next to -o and removes it;
# a killed compile can leave one behind)
/.*.ainl-codegen.c

# examples/stdlib.ainl's scratch file. AINL has no delete builtin, so the
# example cannot clean up after itself and the file survives the run.
ainl-stdlib-example.tmp

# Secrets (keep tokens/keys out of the repo)
*.env
config.env
*.log

# OS
.DS_Store
