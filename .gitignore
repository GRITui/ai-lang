# Rust
/target
**/*.rs.bk
Cargo.lock

# Release packaging output
/dist

# AOT codegen scratch (ainl compile writes this next to -o and removes it;
# a killed compile can leave one behind)
/.*.ainl-codegen.c

# examples/stdlib.ainl's scratch file. AINL gained `delete-file` in Tier 1, so
# the example now cleans up its own scratch file on a successful run; this entry
# only matters when a run is interrupted, leaving one behind.
ainl-stdlib-example.tmp*

# Secrets (keep tokens/keys out of the repo)
*.env
config.env
*.log

# OS
.DS_Store
